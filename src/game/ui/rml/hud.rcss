body
{
	width: 640px;
	height: 360px;
	margin: 0px;
	padding: 0px;
	font-family: Open Sans;
	font-size: 10px;
	color: #ffffff;
}

#status
{
	position: absolute;
	right: 0px;
	top: 0px;
	width: 64px;
	height: 360px;
	box-sizing: border-box;
	background-color: #000000ff;
	padding: 4px;
	z-index: 10;
}

#status .label
{
	margin-bottom: 2px;
}

#status .value
{
	font-size: 12px;
}

#status-top .label,
#status-top .value
{
	display: block;
}

#status-wave
{
	margin-top: 12px;
}

#status-wave .label,
#status-wave .value
{
	display: block;
}

#status-bottom
{
	position: absolute;
	bottom: 4px;
	left: 4px;
	right: 4px;
}

#wave-banner
{
	position: absolute;
	top: 12px;
	width: 640px;
	text-align: center;
	font-size: 16px;
	z-index: 5;
}
